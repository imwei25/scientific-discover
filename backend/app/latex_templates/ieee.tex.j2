{% extends "_base.tex.j2" %}
{# IEEE Transactions —— 使用官方 IEEEtran 类 (journal 模式);
   若稿件含中文, 由 latexexport.py 自动切到 article+ctex, 不会走到这里。

   审计要点:
   - journal 模式必须用 \author{Name~\IEEEmembership{}\thanks{Affiliation}}, 而不是会议模式的
     \IEEEauthorblockN/A (前者是 Transactions 官方 bare_jrnl.tex 的形式)。
   - 必须加 \markboth{Journal Name}{Author et al.: Short Title}, 否则页眉空白。
   - hyperref 必须放最后 + colorlinks=false, IEEE 明确警告彩色链接可能触发拒稿。
   - \IEEEpeerreviewmaketitle 只在 [peerreview] 模式生效, journal 模式是 no-op, 已移除。
#}
{% block author_block %}\author{[作者姓名，请补充]~\IEEEmembership{Member,~IEEE}%
\thanks{[单位、通讯地址、邮箱，请补充]}}
{% endblock %}
{# short_title 已在 Python 侧用 _short_title() 截到词边界 + 转义安全, 这里不再做 Jinja [:60]
   切片 —— 后者在已 escape 的字符串上会切在 \textbf{ 之类命令中间, 导致编译失败。 #}
{% block markboth %}\markboth{ {{- journal_name -}} , Vol.~XX, No.~Y, Month~YYYY}%
{ {{- short_title | default(title) -}} }
{% endblock %}
{% block keywords_block %}\begin{IEEEkeywords}
{{ keywords }}
\end{IEEEkeywords}
{% endblock %}
