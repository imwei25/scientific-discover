# 服务器 /etc/caddy/Caddyfile 的多用户目标形态（单域名 + 路径路由）。
#
#   Internet ─HTTPS─> Caddy(单域名) ──> 127.0.0.1:8090 (manager) ──按路径首段 /用户名/ 分发并剥前缀──> 各用户容器
#
# 一个站点块搞定所有用户：Caddy 只管 TLS + 转发，路由/唤醒/停机全在 manager。
# 加/减用户不需要动 Caddy（manager 热加载即可）。

{
	# 用于 Let's Encrypt 证书通知；改成你的邮箱
	email you@example.com
}

weigu.duckdns.org {
	# 访问日志 —— 别删：fail2ban 的 caddy-login jail（deploy/fail2ban/caddy-login.jail）
	# 就是读这个文件来统计登录 401 爆破的。Caddy 默认【不记】access log，
	# 少了这一块 jail 会因 logpath 不存在而起不来 → 登录爆破防护静默失效，
	# 而 DEPLOY.md 还写着"fail2ban 已装 caddy-login jail"，让人以为在保护。
	# （setup.sh 生成的 Caddyfile 里也有这段；两条部署路径已对齐——含下面的 header 安全头。）
	log {
		output file /var/log/caddy/access.log
		format json
	}
	# 安全响应头（HSTS 强制 HTTPS、禁 MIME 嗅探、限制引用来源、只允许同源内嵌以防点击劫持）
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"   # 产物预览用同源 iframe，故 SAMEORIGIN 而非 DENY
		-Server
	}
	reverse_proxy 127.0.0.1:8090 {
		flush_interval -1        # SSE / 流式输出不缓冲
	}
	request_body {
		max_size 100MB           # 允许上传较大数据文件
	}
	encode zstd gzip
}
