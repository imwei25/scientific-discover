# 服务器 /etc/caddy/Caddyfile 的多用户目标形态（单域名 + 路径路由）。
#
#   Internet ─HTTPS─> Caddy(单域名) ──> 127.0.0.1:8090 (manager) ──按路径首段 /用户名/ 分发并剥前缀──> 各用户容器
#
# 一个站点块搞定所有用户：Caddy 只管 TLS + 转发，路由/唤醒/停机全在 manager。
# 加/减用户不需要动 Caddy（manager 热加载即可）。

{
	# 用于 Let's Encrypt 证书通知；改成你的邮箱
	email you@example.com
}

weigu.duckdns.org {
	reverse_proxy 127.0.0.1:8090 {
		flush_interval -1        # SSE / 流式输出不缓冲
	}
	request_body {
		max_size 100MB           # 允许上传较大数据文件
	}
	encode zstd gzip
}
