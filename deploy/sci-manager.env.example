# sci-manager 的【可变配置】。setup.sh 会把它装到 /etc/sci-manager.env（chmod 600），
# 并且【只在文件不存在时创建、之后永不覆盖】——所以在这里改的值不会被重跑 setup.sh 冲掉。
# （历史教训：这些值以前直接写在 systemd 单元里，setup.sh 每次重装都用仓库模板覆写单元，
#   把运维调过的 WARM_CAP 和管理密码静默改回默认值，且 `enable --now` 对已运行服务不重启，
#   要等下次重启才发作——典型的延时炸弹。）
#
# 改完生效： sudo systemctl restart sci-manager

# ---- 网页管理台 /admin ----
# 留空 = 关闭管理台（默认，也是最安全的）。要开就设一个强密码。
# ⚠ 管理台能加删用户、改档位、往 LLM 网关塞渠道；设弱口令等于把服务器交出去。
# 生成强密码： openssl rand -base64 24
ADMIN_PASSWORD=

# ---- 容量 ----
# WARM_CAP：最多几个用户容器同时在跑（起第 N+1 个前先按 LRU 停掉一个真正空闲的）。内存是硬顶，绝不超配。
# 5 是在 2 vCPU / 3.4 GB 的机器上实测定的：5 人同时跑 md→PDF 全部成功，内存峰值 2668/3495 MB，
# swap 零使用、零 OOM。换机器请重新实测再改：容器空闲约 261 MB/个，重活时远不止。
WARM_CAP=5

# 容器空闲多久后回收（毫秒；默认 10 分钟）
IDLE_MS=600000

# 冷启动等待与抢容量等待（毫秒）
START_TIMEOUT_MS=60000
CAP_WAIT_MS=120000
