# 复制成 deploy/.env 并填入真实值
DEEPSEEK_API_KEY=sk-你的deepseek密钥
# 模型（provider/model 形式）。用你的 DeepSeek 账号里可用的模型名。
OC_MODEL=deepseek/deepseek-v4-pro

# ---- 多用户部署用 ----
# DuckDNS 令牌（scripts/duckdns-sync.sh 刷新各子域 IP）。子域仍需先在 duckdns.org 面板手动创建（免费最多 5 个）。
DUCKDNS_TOKEN=你的duckdns令牌
# 用户域名模板，{name} 替换为用户名（user-add.sh 用）
DOMAIN_TEMPLATE=weigu-{name}.duckdns.org
