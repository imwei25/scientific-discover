# 用户配置示例。复制成 <用户名>.env 手填，或直接用 scripts/user-add.sh 自动生成（推荐）。
# 含明文密码 —— 真实文件勿入库（本目录 .gitignore 已排除 *.env）。
NAME=alice                             # 也是访问路径段：https://<BASE_DOMAIN>/alice/
PORT=3001                              # 宿主回环发布端口（每用户唯一；user-add.sh 自动分配，从 3001 起）
LAN_AUTH=1                             # 1=开登录，0=关（多用户务必开）
LAN_USER=alice                         # 登录账号
LAN_PASSWORD=change-me-strong-password # 登录密码（user-add.sh 会生成 20 位强随机密码）
TIER=free                              # 档位（见 deploy/tiers.env）：决定每日额度与存储上限。改档位用 scripts/user-tier.sh <名> <档位>
# 下面两行为「个别覆盖」：取消注释填值即优先于档位；留空/注释则按档位。0=不限。
#DAILY_COST_LIMIT=                     # 每日成本上限(USD)；改后 render-compose.sh + docker restart agent-<name> 生效
#STORAGE_LIMIT_MB=                     # 存储上限(MB)（uploads+outputs）；达 90% 前端提示、满则拦上传
#MODULES=                              # 功能模块授权（逗号分隔；空=全部）：chat=自由对话 grant=标书撰写 refcheck=文献真实性检查 humanize=去AI味写作
                                       # 改授权用 scripts/user-modules.sh <名> <列表|all>（须重建容器生效，脚本会自动做）
#SKILLS=                               # 技能白名单（逗号分隔技能目录名；空=全部）：自由对话里只许调这些技能；模块的绑定技能被收权则该模块不可用
                                       # 改白名单用 scripts/user-skills.sh <名> <列表|all>；清单见 user-skills.sh --list
