# 通用医学期刊送审稿预设（不确定目标期刊、或期刊未列入预设时的安全默认）
# = 本套件的「默认投稿格式」：用户没指定期刊 / 不知道投哪时，write-paper 排版一律用它。
# ICMJE 系期刊的公约数 + 用户默认要求：Times New Roman 12pt、双倍行距、连续行号、
# 页码、正文每段首行缩进 4 英文字符、图表题 10.5pt 居中（序号加粗）、表内 10pt、
# 三线表（顶/底 1.5 磅、表头下 0.5 磅）、论文标题 16pt / 一级标题 14pt / 其余标题
# 12pt 全加粗（各级都不小于正文）、作者与机构 10.5pt 居中。
PRESET_MARGIN="1in"
PRESET_FONT="Times New Roman"
# eastAsia 字体只作用于稿件里的 CJK 字符：纯英文稿无影响，中文稿避免落到"等线"
PRESET_CJKFONT="宋体"
PRESET_FONTSIZE="12"
PRESET_LINESPACING="2.0"
PRESET_LINENUMBERS="1"
PRESET_PAGENUMBERS="1"
PRESET_INDENT_CHARS="4"
PRESET_CAPTION_FONTSIZE="10.5"
PRESET_TABLE_FONTSIZE="10"
PRESET_HEADING_FONTSIZE="12"
PRESET_H1_FONTSIZE="14"
PRESET_TITLE_FONTSIZE="16"
PRESET_AUTHOR_FONTSIZE="10.5"
PRESET_CSL="vancouver.csl"
PRESET_NOTE="通用送审格式（默认）：Times New Roman 12pt、双倍行距、连续行号、页码、首行缩进4字符、图表题10.5pt/表内10pt、标题16/14/12pt加粗、1in 边距、Vancouver 参考文献。页边距不限（文章过长可自行换窄边距）；正文（不含图表文献）以 ~30 页为软上限，超 1-3 页可接受——页数以 Word 打开后实际为准，脚本无法离线精确统计。确定目标期刊后换用对应预设或按该刊稿约微调。"
