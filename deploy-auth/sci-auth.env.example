# /etc/sci-auth.env —— sci-auth 的全部配置与机密（chmod 600，root 独有）
#
# 这是服务器上【唯一】的机密来源。迁移脚本会把它整个带走（设 MIGRATE_PASSPHRASE 则加密）。
# 别把这些值写进 systemd 单元的 Environment=：单元文件 systemctl cat 就能看，等于公开。

# ---- 监听 ----
# 只听回环：唯一对公网开放的是 Caddy，它反代到这里。
LISTEN=127.0.0.1:8090

# ---- 数据 ----
DATA_DIR=/var/lib/sci-auth
# DB_FILE 不设则为 $DATA_DIR/sci.db
#DB_FILE=/var/lib/sci-auth/sci.db

# ---- 管理台 ----
# 不设 = 管理台整个 404（线上如果暂时不想开后台，就留空）。
# 设一个长随机串；改了它，所有管理员会话立刻失效（签名密钥就是它本身）。
ADMIN_PASSWORD=

# ---- access key 签名密钥 ----
# 不设则首次启动自动生成并存进库（推荐显式设，迁移时两台机保持一致，否则全体客户端要重新登录）。
# 生成：openssl rand -base64 32
KEY_SECRET=

# ---- 票据有效期 ----
# access key 短、refresh 长；改档/停用靠 key_epoch 立刻吊销，不依赖这里调短。
#
# ⚠ systemd 的 EnvironmentFile【不剥行尾注释】：写成 `ACCESS_TTL_MS=86400000  # 24 小时`
#   会把 "86400000  # 24 小时" 整串当成值。所以本文件里注释一律【单独占一行】。
#   （真踩过：REFRESH_TTL_MS 带了行尾注释 → NaN → 登录时报 NOT NULL constraint failed。
#     现在 sci-auth 遇到非法数值会启动即失败并指出这一条，不会再拖到运行时才炸。）
# 24 小时
ACCESS_TTL_MS=86400000
# 30 天
REFRESH_TTL_MS=2592000000

# ---- 上游模型 ----
# 走 one-api 做多渠道调度/故障切换（默认形态，换供应商/换渠道对客户端透明）：
LLM_UPSTREAM_URL=http://127.0.0.1:3010/v1
# ⚠ one-api 的令牌在它自己库里存的是【不带 sk- 前缀】的，而调用时必须带。
#   这里要填 sk-<库里那串>。取法：
#   docker run --rm -v one-api-data:/d:ro alpine sh -c \
#     'apk add -q sqlite && sqlite3 /d/one-api.db "SELECT key FROM tokens WHERE status=1 LIMIT 1"'
#   这不是 one-api 的「系统访问令牌」（那个是管理 API 用的，见下面的 ONEAPI_TOKEN 说明）。
LLM_UPSTREAM_KEY=
# 直连 DeepSeek（不做多渠道时）：
#LLM_UPSTREAM_URL=https://api.deepseek.com
#LLM_UPSTREAM_KEY=sk-...
#
# 两种写法的 baseURL 客户端都能用：<域名>/llm 与 <域名>/llm/v1
# （网关会消掉重复的 /v1，见 server/lib/gateway.mjs 的 joinUpstream）

# ---- 计价（USD / 百万 token）----
# 必须与上游实际计费口径一致，否则额度会系统性偏。改单价前先对一次账单。
COST_INPUT=0.27
COST_OUTPUT=1.10
COST_CACHE_READ=0.07

# ---- 技能清单来源 ----
# 后台的技能白名单从这个目录现读（加了新技能不用重启）。
SKILLS_DIR=/root/sci-agent/.opencode/skills

# ---- 测试旁路（生产【不要】设）----
# 设了它，带对应请求头的管理台登录可跳过图形验证码（口令仍要对）。仅供无人值守回归测试。
#TEST_BYPASS_TOKEN=
