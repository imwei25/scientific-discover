# /etc/caddy/Caddyfile —— 唯一对公网开放的东西。
# 把 example.duckdns.org 换成你的域名；Caddy 会自动签发/续期证书。

example.duckdns.org {
	encode zstd gzip

	# 上传体积上限：默认留小（桌面客户端平时不往服务器传大文件），
	# 确实要传的两条路在下面各自放宽 —— 别为了那两条把全站都开成几十 MB。
	request_body {
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# LLM 转发：推理首字节可以很慢、响应是长流 —— 必须关掉缓冲，否则流式输出会被攒住。
	handle /llm/* {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
			transport http {
				# 别给长推理设读超时，误杀比挂着更糟。
				#
				# ⚠ 这个值必须【明显大于】后台「并发与排队」里的「最长等待」（默认 5 分钟）：
				#   并发满时请求会先在 sci-auth 里排队，那段时间响应头还没发出 —— 两者相加都算在
				#   这个超时里。配小了就会出现"排队快轮到了，却被 Caddy 以 504 掐掉"，
				#   而日志里只有一个看不出原因的 504。
				response_header_timeout 15m
			}
		}
	}

	# 用户反馈上传：一次会话的完整对话 + 用户勾选的产出文件（图/表/docx）。
	# 【必须单独放宽】全站默认的 2MB 对它太小 —— 用户随手带一张森林图就被 Caddy 以 413 打回，
	# 而且那是 Caddy 自己的错误页，客户端拿不到我们的结构化提示，用户只看到"提交失败"。
	# 服务端另有自己的两道闸（单次 32MB、单附件 8MB），这里留点余量给 zip 头与多附件。
	handle /api/feedback {
		request_body {
			max_size 40MB
		}
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
		}
	}

	# 管理台手动上传技能包 / 界面包（zip）。技能包整包可以到几十 MB。
	handle /admin/api/skill-pack-upload /admin/api/web-pack-upload {
		request_body {
			max_size 80MB
		}
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8090 {
			flush_interval -1
		}
	}

	log {
		output file /var/log/caddy/access.log
		format json
	}
}

# fail2ban 的 caddy-login jail 认的是 access.log 里 /admin/api/login 与
# /api/auth/login 的 401。改路径要同步改 /etc/fail2ban/filter.d/caddy-login.conf。
