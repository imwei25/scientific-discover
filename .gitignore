# 密钥与虚拟环境（保留在磁盘上，但不进 git）
backend/.env
backend/.venv/
.venv/

# 旧产品的遗留目录（未跟踪的构建产物，不进 git）
backend/
frontend/
src-tauri/

# 运行时产物
outputs/
uploads/
node_modules/
*.log

# Python 缓存
__pycache__/
*.pyc

# 部署密钥与密码文件（绝不入库）
deploy/.env
deploy/htpasswd
.env
serve.out
serve.err
# 自定义大模型配置（含 API key，运行时由前端「模型设置」写入）
web/model-config.json
opencode.json

# 档位定义：管理台(/admin 的 tier-def 接口)会在运行时重写它（见 deploy/manager.mjs），
# 属于「机器上的实际配置」而非源码——与 deploy/.env、users/*.env、docker-compose.yml 同类。
# 跟踪它会让服务器 git status 永远是脏的、每次 pull 都可能冲突。
# 模板见 deploy/tiers.env.example；首次部署由 setup.sh/手工 cp 一份。
deploy/tiers.env

# 导出/备份产物：含 .env 与 users/*.env（全部账号 + 明文密码）与用户数据。
# export-all.sh 的默认目录已改到仓库之外（/var/backups/sci-export），这几条是兜底——
# 万一有人显式传了仓库内路径，也不能让它进 git 历史（历史里删不干净）。
deploy/backups/
backups/
sci-agent-backup-*.tar.gz
