# 密钥与虚拟环境（保留在磁盘上，但不进 git）
backend/.env
backend/.venv/
.venv/

# 旧产品的遗留目录（未跟踪的构建产物，不进 git）——锚定仓库根：
# 不加 / 会匹配任意深度的同名目录，曾把 .opencode/skills/nature-figure/static/fragments/backend/ 吞掉
/backend/
/frontend/
/src-tauri/

# 运行时产物
outputs/
uploads/
node_modules/
*.log

# Python 缓存
__pycache__/
*.pyc

# 部署密钥与密码文件（绝不入库）
.env
serve.out
serve.err
# 「编辑技能」的出厂底稿（内部版运行时产生：用户第一次改某个技能前留的原文，供恢复出厂）
skill-edits/
# 自定义大模型配置（含 API key，运行时由前端「模型设置」写入）
web/model-config.json
# 直连 API 的凭证档（含 API key，用户勾了「保存在本机」才生成，最多 3 套）
web/api-profiles.json
opencode.json

# 桌面版（路线2）构建产物：bundle 组装目录（GB 级）与 Rust 构建缓存。
# icons/ 与 app-icon.png 刻意【跟踪】：tauri.conf.json 引用 icons/icon.ico，进 git 才能克隆即构建
desktop/dist/
desktop/launcher/target/
desktop/launcher/gen/

# 导出/备份产物：含账号、口令与用户数据。ops/migrate-export.sh 的默认目录已在仓库之外
# （/var/backups/sci-auth），这两条是兜底——万一有人显式传了仓库内路径，
# 也不能让它进 git 历史（历史里删不干净）。
backups/
sci-agent-backup-*.tar.gz

# Office 锁文件（Word/Excel 打开文档期间生成的临时文件），别进库
~$*

# 本地开发用的网关 access key（web/dev-gateway.mjs 读它），别进库
.dev-gateway-key

# 桌面版云端账号登录态（含 refresh token），绝不能进库
web/cloud-state.json
cloud.json

# 会话/项目元数据（项目分组、持久化标记、到期时间；运行时生成）
web/sessions-meta.json

# 定时任务：无头运行器的环境快照（壳每次启动写，【原样带着 OC_GATEWAY_KEY】，与 model-config.json 同类）
web/headless-env.json

# 桌面版本机开关（关闭时完全退出；开机自启动现查注册表不存这儿）。用户在设置里勾出来的，
# 开发机跑一次 dev-gateway 也会生成。打包侧同样排除（bundle.ps1 的 ExcludeFiles），
# 升级清理侧则明确保留（cleanup-stale.ps1 的 keepAlways）——它是用户设置，不是随包文件。
web/desktop-settings.json

# 聊天接入桥的运行期状态（state.json 含企微 bot 凭证、config.toml 是生成物、bridge.log 是日志）
/chat-bridge/
# 用户自己建的定时任务定义与运行记录（运行时生成）
/tasks/

# PowerShell 模块分析缓存：本机运行时产物，被 `git add -A` 扫进来过一次
Microsoft/

# 本机 opencode 的 provider 配置（含上游 API key，与上面的 opencode.json 同一类东西，
# 只是文件名不同）。此前【没有】任何一条规则挡它 —— 一次 `git add -A` 就会把 key 提进历史，
# 而历史里的密钥删不干净，只能整把作废重换。
config.json

# push 被拦时用 `git bundle create` + scp 传包留下的中转产物（deploy-r*.bundle）。
# 随时可以重新生成，没有留在仓库里的理由；曾经攒到 28 个。
deploy-r*.bundle

# 「界面包」在线发布时打出来的分发包（web/*.html + pack.json）。与 deploy-r*.bundle 同类：
# 从当前工作区随时能重打一份，版本号又带着日期，攒在仓库根只会让 git status 长期是脏的。
webpack-*.zip

# 技能跑出来的证据表等产物，落在仓库根只是因为当时的工作目录在这儿
zotero_evidence.csv

# ppt-master 的项目工作区与开发期的试验残留。都是【本机产物】：换台机器重跑一遍
# 就有，而且体量不小（各几 MB、上百个文件），跟着仓库走只会让 clone 变慢、
# git status 长期是脏的。文件本身留在磁盘上，需要的人照旧能翻。
projects/
scratchpad/

# opencode 的配置目录（XDG_CONFIG_HOME），由网关圈在应用内：一个指向 .opencode/skills 的
# 联接 + 随包预置的插件运行时（见 server.mjs 的 OC_GLOBAL_CFG 与 desktop/bundle.ps1）。
# 纯本机产物、且含 junction 与几万个依赖文件，跟着仓库走没有意义。
.ocglobal/
